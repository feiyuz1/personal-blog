# 生产环境变量模板
# 复制为 .env.prod 并填入真实值后再执行 docker compose -f compose.prod.yml --env-file .env.prod up -d

# 数据库
POSTGRES_DB=blog
POSTGRES_USER=blog
# 生产务必使用强随机口令
POSTGRES_PASSWORD=replace-with-strong-password

# 站点对外访问地址（用于 SEO 与同源校验，不带末尾斜杠）
NEXT_PUBLIC_SITE_URL=https://your-domain.com
APP_ORIGIN=https://your-domain.com

# 后台会话签名密钥，生产必须用 `openssl rand -base64 32` 生成
SESSION_SECRET=replace-with-openssl-rand-base64-32

# Live2D AI 看板娘
MASCOT_ENABLED=true
MASCOT_LIVE2D_ENABLED=true
MASCOT_AI_ENABLED=true
AI_PROVIDER=siliconflow
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=replace-with-ai-api-key
AI_CHAT_MODEL=replace-with-openai-compatible-model-id
AI_MAX_OUTPUT_TOKENS=384

MASCOT_MAX_INPUT_CHARS=600
MASCOT_HISTORY_TURNS=4
MASCOT_MAX_HISTORY_CHARS=1600
MASCOT_REQUESTS_PER_MINUTE=8
MASCOT_DAILY_REQUEST_LIMIT=30

MASCOT_TTS_ENABLED=true
MASCOT_TTS_PROVIDER=siliconflow
# 留空即回退 AI_BASE_URL / AI_API_KEY
MASCOT_TTS_BASE_URL=
MASCOT_TTS_API_KEY=
MASCOT_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
MASCOT_TTS_VOICE=replace-with-tts-voice-id
MASCOT_TTS_SPEED=1.05
MASCOT_TTS_MAX_CHARS=500
MASCOT_TTS_DAILY_CHAR_LIMIT=5000

MASCOT_PERSONA_NAME=小羽
# 可选：完整覆盖默认 Persona。普通部署留空。
MASCOT_PERSONA_PROMPT=
MASCOT_HOST_SITE_NAME=Feiyuz Blog
MASCOT_HOST_SITE_DESCRIPTION=聚焦 C++、Unreal Engine、图形学、渲染与软件工程的个人技术博客。
MASCOT_MEMORY_ENABLED=false
MASCOT_RAG_ENABLED=false
MASCOT_STT_ENABLED=false
