generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
}

enum PostStatus {
  DRAFT
  PUBLISHED
  OFFLINE
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           BigInt   @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  nickname     String?  @db.VarChar(100)
  email        String?  @unique @db.VarChar(191)
  role         UserRole @default(ADMIN)
  posts        Post[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Category {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  posts       Post[]
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("categories")
}

model Tag {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  postTags  PostTag[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tags")
}

model Post {
  id          BigInt     @id @default(autoincrement())
  title       String     @db.VarChar(255)
  slug        String     @unique @db.VarChar(255)
  summary     String?    @db.Text
  content     String     @db.Text
  coverUrl    String?    @map("cover_url") @db.VarChar(500)
  readingTime String?   @map("reading_time") @db.VarChar(20)
  status      PostStatus @default(DRAFT)
  categoryId  BigInt?    @map("category_id")
  authorId    BigInt     @map("author_id")
  viewCount   Int        @default(0) @map("view_count")
  isTop       Boolean    @default(false) @map("is_top")
  publishedAt DateTime?  @map("published_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author      User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  postTags    PostTag[]
  comments    Comment[]

  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
  @@index([slug])
  @@map("posts")
}

model PostTag {
  id     BigInt @id @default(autoincrement())
  postId BigInt @map("post_id")
  tagId  BigInt @map("tag_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@map("post_tags")
}

model Comment {
  id        BigInt        @id @default(autoincrement())
  postId    BigInt        @map("post_id")
  parentId  BigInt?       @map("parent_id")
  nickname  String        @db.VarChar(100)
  email     String?       @db.VarChar(191)
  content   String        @db.Text
  status    CommentStatus @default(PENDING)
  ip        String?       @db.VarChar(64)
  createdAt DateTime      @default(now()) @map("created_at")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   Comment[]     @relation("CommentReplies")

  @@index([postId])
  @@map("comments")
}

model ContactMessage {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(191)
  message   String   @db.Text
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_messages")
}

enum ProjectStatus {
  PLANNING
  BUILDING
  ONLINE
}

model Project {
  id            BigInt         @id @default(autoincrement())
  name          String         @db.VarChar(150)
  slug          String         @unique @db.VarChar(150)
  summary       String?        @db.Text
  techStack     String?        @map("tech_stack") @db.VarChar(500)
  coverUrl      String?        @map("cover_url") @db.VarChar(500)
  projectUrl    String?        @map("project_url") @db.VarChar(500)
  githubUrl     String?        @map("github_url") @db.VarChar(500)
  status        ProjectStatus  @default(PLANNING)
  role          String?        @db.VarChar(255)
  highlights    Json?          @map("highlights")
  milestones    Json?          @map("milestones")
  articleSlug   String?        @map("article_slug") @db.VarChar(255)
  sortOrder     Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([status])
  @@map("projects")
}

model MediaFile {
  id        BigInt   @id @default(autoincrement())
  fileName  String   @map("file_name") @db.VarChar(255)
  fileUrl   String   @map("file_url") @db.VarChar(500)
  fileType  String   @map("file_type") @db.VarChar(100)
  fileSize  BigInt   @map("file_size")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("media_files")
}

model SiteSetting {
  id             BigInt   @id @default(autoincrement())
  siteTitle      String?  @map("site_title") @db.VarChar(150)
  siteSubtitle   String?  @map("site_subtitle") @db.VarChar(255)
  logoUrl        String?  @map("logo_url") @db.VarChar(500)
  footerText     String?  @map("footer_text") @db.Text
  seoTitle       String?  @map("seo_title") @db.VarChar(255)
  seoDescription String?  @map("seo_description") @db.Text
  seoKeywords    String?  @map("seo_keywords") @db.VarChar(255)
  socialLinks    Json?    @map("social_links")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model ContentBlock {
  id        BigInt   @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content_blocks")
}
