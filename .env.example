POSTGRES_DB="blog_dev"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT="51214"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
DATABASE_URL="prisma+postgres://127.0.0.1:51213/?api_key=YOUR_PRISMA_DEV_API_KEY"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:51215/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# 后台会话签名密钥（JWT HS256）。
# 本地开发可沿用下方占位值；生产环境务必用 `openssl rand -base64 32` 重新生成强随机值，
# 否则会话令牌可被伪造，后台将被完全攻破。
SESSION_SECRET=dev-only-secret-please-replace-in-production-32bytes

# 写接口 Origin 校验（站点公开源，如 https://example.com，不要带末尾斜杠）。
# 本地开发填 http://localhost:3000；生产填正式域名。
APP_ORIGIN=http://localhost:3000

# ==============================
# Live2D AI 看板娘（小羽）
# ==============================

# 主开关关闭时不挂载 Live2D、聊天或语音；子开关可独立关闭。
MASCOT_ENABLED=true
MASCOT_LIVE2D_ENABLED=true
MASCOT_AI_ENABLED=true

# 任意 OpenAI-compatible /v1/chat/completions 服务。
AI_PROVIDER=siliconflow
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=
AI_CHAT_MODEL=
AI_MAX_OUTPUT_TOKENS=384

# 输入、历史、分钟与 UTC 自然日额度。
MASCOT_MAX_INPUT_CHARS=600
MASCOT_HISTORY_TURNS=4
MASCOT_MAX_HISTORY_CHARS=1600
MASCOT_REQUESTS_PER_MINUTE=8
MASCOT_DAILY_REQUEST_LIMIT=30

# TTS 默认复用 AI_BASE_URL / AI_API_KEY；如使用另一服务再填写专用配置。
MASCOT_TTS_ENABLED=true
MASCOT_TTS_PROVIDER=siliconflow
MASCOT_TTS_BASE_URL=
MASCOT_TTS_API_KEY=
MASCOT_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
MASCOT_TTS_VOICE=
MASCOT_TTS_SPEED=0.95
MASCOT_TTS_REQUESTS_PER_MINUTE=24
MASCOT_TTS_MAX_CHARS=500
MASCOT_TTS_DAILY_CHAR_LIMIT=5000

# 宿主与 Persona 可配置；不设置时使用小羽和 Feiyuz Blog 默认值。
MASCOT_PERSONA_NAME=小羽
MASCOT_HOST_SITE_NAME=Feiyuz Blog
MASCOT_HOST_SITE_DESCRIPTION=聚焦 C++、Unreal Engine、图形学、渲染与软件工程的个人技术博客。
# 可选：完整覆盖默认 Persona。普通部署无需填写。
MASCOT_PERSONA_PROMPT=

# 仅预留 Provider/UI，本次默认不持久化记忆、不执行向量检索或语音输入。
MASCOT_MEMORY_ENABLED=false
MASCOT_RAG_ENABLED=false
MASCOT_STT_ENABLED=false
