{
  "name": "personal-blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:standalone && npm run mascot:check-voices && npm run mascot:check-player && npm run mascot:check-chat-stream && npm run mascot:check-tts",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "prestart": "node scripts/prepare-standalone.mjs",
    "start": "node --env-file=.env .next/standalone/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:standalone": "node --test scripts/prepare-standalone.test.mjs",
    "mascot:cache-voices": "tsx scripts/generate-mascot-interaction-voices.ts",
    "mascot:check-voices": "tsx scripts/generate-mascot-interaction-voices.ts --check",
    "mascot:check-player": "tsx scripts/check-mascot-interaction-player.ts",
    "mascot:check-chat-stream": "tsx scripts/check-mascot-chat-stream.ts",
    "mascot:check-tts": "tsx scripts/check-mascot-tts.ts",
    "db:up": "prisma dev -d --name personal-blog",
    "db:down": "prisma dev stop personal-blog",
    "db:status": "prisma dev ls",
    "db:docker:up": "docker compose up -d postgres",
    "db:docker:down": "docker compose down",
    "db:docker:logs": "docker compose logs -f postgres",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:reset": "prisma migrate reset --force",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force --seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.35",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.3",
    "@prisma/client": "^6.18.0",
    "ai": "^7.0.77",
    "bcryptjs": "^3.0.3",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.9",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "pg": "^8.20.0",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^6.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
